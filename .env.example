APP_NAME="Translation Management Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Work factor 10 is the OWASP minimum and keeps login under the 200ms budget
# (12 costs roughly 250ms per attempt). Raise it if login latency matters less.
BCRYPT_ROUNDS=10

# Minutes until an issued API token expires (empty = never).
SANCTUM_TOKEN_EXPIRATION=1440

# Requests per minute.
API_RATE_LIMIT=300
LOGIN_RATE_LIMIT=5

# Set to true to serve the JSON export without a token, e.g. behind a CDN.
TRANSLATIONS_EXPORT_PUBLIC=false
# Seconds a CDN may reuse an export without revalidating (0 = always revalidate).
TRANSLATIONS_EXPORT_CDN_MAX_AGE=0
# Seconds a built export stays in the application cache (0 = disabled).
TRANSLATIONS_EXPORT_CACHE_TTL=3600

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Holds rate-limit counters and built exports. Use redis when running several instances.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
